# ==============================================================================
# CHECKTALENT BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API / Data API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://ttzmcpvffmicmhbaadfb.supabase.co

# Anon / Publishable API Key (Client-facing key)
SUPABASE_ANON_KEY=sb_publishable_DZo-IlPuHbnvhEpbVHZdIg_xLExqKus

# Service Role Secret Key (Bypasses Row Level Security for backend administrative tasks)
# Found in: Project Settings -> API -> Project API Keys -> "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Optional: Direct PostgreSQL Database Connection URL (for direct migrations or poolers)
# Found in: Project Settings -> Database -> Connection String -> URI
# SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ttzmcpvffmicmhbaadfb.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# FIREBASE ADMIN AUTHENTICATION
# Found in: Firebase Console -> Project Settings -> Service accounts
# ------------------------------------------------------------------------------
# Firebase Project ID (Matches frontend NEXT_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=checktalent-85fbf

# Option A (Recommended for production): Service Account Private Key & Client Email
# Generated by clicking "Generate new private key" in Firebase Console -> Service Accounts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@checktalent-85fbf.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to downloaded Service Account JSON file (e.g. serviceAccountKey.json)
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
